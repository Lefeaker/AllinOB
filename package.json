{
  "name": "zendio",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <21",
    "npm": ">=10 <11"
  },
  "scripts": {
    "clean": "rimraf build/dist build/releases",
    "typecheck": "npm run typecheck:app && npm run typecheck:tests",
    "typecheck:app": "tsc --noEmit --project tsconfig.json",
    "typecheck:tests": "tsc --noEmit --project tsconfig.tests.json",
    "typecheck:strict": "tsc --noEmit --project tsconfig.strict.json",
    "lint": "eslint src tests --ext .ts,.tsx,.js",
    "lint:fix": "npm run lint -- --fix",
    "lint:type-any": "node scripts/audit-types.mjs --format summary",
    "lint:type-any:ratchet": "node scripts/audit-types.mjs --format summary --max-any 0 --max-unknown 1190 --max-assertions 1996 --max-non-null 50 --max-ts-expect-error 3 --max-src-any 0 --max-src-unknown 668 --max-src-assertions 715 --max-src-non-null 9 --max-src-ts-expect-error 0 --max-tests-any 0 --max-tests-unknown 522 --max-tests-assertions 1281 --max-tests-non-null 41 --max-tests-ts-expect-error 3",
    "lint:hardcoded": "node scripts/lint-hardcoded-values.mjs",
    "audit:i18n-hardcoded-user-copy": "node tools/report-production-build-graph.mjs --write-json build/reports/production-build-graph.json >/dev/null && node scripts/audit-i18n-hardcoded-user-copy.mjs",
    "audit:i18n-hardcoded-user-copy:check": "node tools/report-production-build-graph.mjs --write-json build/reports/production-build-graph.json >/dev/null && node scripts/audit-i18n-hardcoded-user-copy.mjs --check",
    "audit:i18n-uncatalogued-user-copy": "node tools/report-production-build-graph.mjs --write-json build/reports/production-build-graph.json >/dev/null && node scripts/audit-i18n-uncatalogued-user-copy.mjs",
    "audit:i18n-uncatalogued-user-copy:check": "node tools/report-production-build-graph.mjs --write-json build/reports/production-build-graph.json >/dev/null && node scripts/audit-i18n-uncatalogued-user-copy.mjs --check",
    "lint:options-css": "stylelint \"src/options/**/*.css\"",
    "lint:warnings-report": "node scripts/lint-warnings-report.mjs",
    "lint:warnings-guard": "node scripts/lint-warnings-guard.mjs",
    "audit:deps:report": "node tools/report-dependency-cruiser-coverage.mjs",
    "audit:platform-boundary:report": "node tools/report-platform-boundary.mjs",
    "audit:platform-services:report": "node tools/report-platform-services-allowlist.mjs",
    "audit:design-tokens:report": "node tools/report-design-token-alignment.mjs",
    "audit:design-system-doc:report": "node tools/report-design-system-doc.mjs",
    "audit:interaction-contract:report": "node tools/report-interaction-contract.mjs",
    "audit:options-mainline:report": "node tools/report-options-mainline.mjs",
    "audit:repository-composition:report": "node tools/report-repository-composition.mjs",
    "audit:locales:report": "node tools/report-locale-source-alignment.mjs",
    "audit:imports:report": "node tools/report-deep-imports.mjs",
    "audit:imports:check": "node tools/report-deep-imports.mjs --check",
    "audit:chrome-webstore-release:check": "node tools/report-chrome-webstore-release-workflow.mjs --check",
    "audit:components:report": "node tools/report-component-entry-alignment.mjs",
    "audit:compatibility-duplicates:report": "node tools/report-compatibility-duplicates.mjs",
    "audit:compatibility-duplicates:check": "node tools/report-compatibility-duplicates.mjs --check",
    "audit:build-graph:report": "node tools/report-production-build-graph.mjs",
    "audit:production-build-graph:report": "node tools/report-production-build-graph.mjs",
    "audit:non-production-source:report": "node tools/report-non-production-source.mjs",
    "audit:non-production-source:check": "node tools/report-non-production-source.mjs --check",
    "audit:retired-code:report": "node tools/report-retired-code-inventory.mjs",
    "audit:production-shape:report": "node tools/report-production-code-shape.mjs",
    "audit:build:report": "node tools/report-build-splitting.mjs",
    "audit:ci-workflow:check": "node tools/report-ci-workflow-contract.mjs --check",
    "audit:local-vault-release:report": "node scripts/audit-local-vault-release-readiness.mjs",
    "audit:performance:report": "node tools/report-performance-hotspots.mjs",
    "audit:ga:proxy-contract": "node tools/report-ga-proxy-contract.mjs --check",
    "audit:ga:docs": "node tools/report-ga-docs-contract.mjs --check",
    "audit:ga:legacy-api": "node tools/report-ga-legacy-api.mjs --check",
    "audit:ga:client-secret": "node tools/report-ga-client-secret.mjs --check",
    "audit:ga:release-surface": "node tools/report-ga-release-surface.mjs --check",
    "audit:release-surface:report": "node tools/report-release-surface.mjs",
    "audit:release-surface:check": "node tools/report-release-surface.mjs --check",
    "manifest:generate": "node scripts/generate-manifests.mjs",
    "release:metadata:sync": "node scripts/sync-release-metadata.mjs",
    "release:metadata:check": "node scripts/sync-release-metadata.mjs --check",
    "i18n:catalog:generate": "tsx tools/generate-i18n-catalog.ts",
    "i18n:catalog:check": "tsx tools/generate-i18n-catalog.ts --check",
    "i18n:generate": "node scripts/gen-locales.mjs",
    "i18n:lint": "node scripts/lint-i18n.mjs",
    "i18n:guard": "node scripts/i18n-guard.mjs",
    "layout:report": "node scripts/layout-report.mjs",
    "test:i18n:layout": "npm run verify:runtime && npm run layout:report",
    "test:i18n:visual": "npm run verify:runtime && playwright test --config=playwright.config.ts",
    "validate:i18n:budgets": "tsx tools/validate-text-budgets.ts",
    "generate:i18n:pseudo": "tsx tools/generate-pseudo-locale.ts",
    "test:i18n": "npm run verify:runtime && npm run i18n:lint && npm run validate:i18n:budgets && npm run test:i18n:layout",
    "quality:i18n": "npm run test:i18n && npm run test:i18n:visual",
    "report:layout": "node tools/generate-layout-summary.mjs",
    "report:release-summary": "node tools/generate-release-summary.mjs",
    "format": "prettier --write \"{src,tests,docs}/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"{src,tests,docs}/**/*.{ts,tsx,js,jsx,json,md}\"",
    "quality": "node scripts/quality-check.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "build": "npm run quality && node scripts/build.mjs --mode=prod --skip-checks",
    "build:fast": "node scripts/build.mjs --mode=prod --skip-checks",
    "build:dev": "node scripts/build.mjs --skip-checks",
    "build:firefox": "npm run quality && node scripts/build.mjs --mode=prod --skip-checks --firefox",
    "build:firefox:fast": "node scripts/build.mjs --mode=prod --skip-checks --firefox",
    "build:firefox:dev": "node scripts/build.mjs --skip-checks --firefox",
    "build:chrome:isolated": "npm run build:fast -- --outdir build/dist-chrome",
    "build:firefox:isolated": "npm run build:firefox:fast -- --outdir build/dist-firefox",
    "analytics:validate:prod": "node --env-file-if-exists=.env.production.local scripts/setup-error-analytics.js",
    "analytics:smoke:delivery": "node --env-file-if-exists=.env.production.local scripts/analytics-delivery-smoke.mjs",
    "build:prod:ga": "npm run quality && node --env-file=.env.production.local scripts/build.mjs --mode=prod --skip-checks",
    "build:prod:ga:fast": "node --env-file=.env.production.local scripts/build.mjs --mode=prod --skip-checks",
    "build:firefox:prod:ga": "npm run quality && node --env-file=.env.production.local scripts/build.mjs --mode=prod --skip-checks --firefox",
    "build:firefox:prod:ga:fast": "node --env-file=.env.production.local scripts/build.mjs --mode=prod --skip-checks --firefox",
    "package:prod:ga": "npm run build:prod:ga && node scripts/package.mjs",
    "package:firefox:prod:ga": "npm run build:firefox:prod:ga && node scripts/package-firefox.mjs",
    "release:prod:ga": "npm run build:prod:ga && node scripts/create-release.mjs",
    "dev": "node scripts/build.mjs --watch --skip-checks",
    "dev:firefox": "node scripts/build.mjs --watch --skip-checks --firefox",
    "preview:typecheck": "tsc --noEmit --project tsconfig.preview.json",
    "preview:build": "node scripts/build-preview.mjs",
    "preview:build:stitch-secondary": "node scripts/build-preview.mjs",
    "preview:freeze-check": "node scripts/preview-freeze-check.mjs",
    "preview:freeze-check:update-baseline": "node scripts/preview-freeze-check.mjs --update-baseline",
    "test": "npm run verify:runtime && vitest run",
    "test:unit": "npm run verify:runtime && vitest run --config vitest.unit.config.ts",
    "test:unit:shards": "npm run verify:runtime && node scripts/run-test-shards.mjs unit",
    "test:unit:shard:background": "npm run verify:runtime && node scripts/run-test-shards.mjs unit background",
    "test:unit:shard:content": "npm run verify:runtime && node scripts/run-test-shards.mjs unit content",
    "test:unit:shard:options": "npm run verify:runtime && node scripts/run-test-shards.mjs unit options",
    "test:unit:shard:shared": "npm run verify:runtime && node scripts/run-test-shards.mjs unit shared",
    "test:unit:shard:tools": "npm run verify:runtime && node scripts/run-test-shards.mjs unit tools",
    "test:e2e": "npm run verify:runtime && vitest run --config vitest.e2e.config.ts",
    "test:e2e:shards": "npm run verify:runtime && node scripts/run-test-shards.mjs e2e",
    "test:e2e:shard:ai-chat": "npm run verify:runtime && node scripts/run-test-shards.mjs e2e ai-chat",
    "test:e2e:shard:content": "npm run verify:runtime && node scripts/run-test-shards.mjs e2e content",
    "test:e2e:shard:options": "npm run verify:runtime && node scripts/run-test-shards.mjs e2e options",
    "test:e2e:shard:video": "npm run verify:runtime && node scripts/run-test-shards.mjs e2e video",
    "test:e2e:browser": "npm run verify:runtime && node scripts/run-playwright.mjs test tests/visual/yaml-config.interaction.spec.ts",
    "test:e2e:browser:parallel": "npm run verify:runtime && npm run build:dev && node scripts/run-browser-test-shards.mjs e2e",
    "test:e2e:browser:local-vault": "npm run verify:runtime && node scripts/run-playwright.mjs test tests/visual/local-vault-write-harness.spec.ts --project=chromium-desktop",
    "test:e2e:browser:smoke": "npm run verify:runtime && node scripts/run-playwright.mjs test tests/visual/migration-harness.spec.ts --project=chromium-desktop",
    "test:e2e:browser:reader-panel": "npm run verify:runtime && node scripts/run-playwright.mjs test tests/e2e/readerPanelFlow.test.ts --config=playwright.reader.config.ts",
    "test:e2e:browser:firefox": "npm run verify:runtime && node scripts/run-firefox-browser-tests.mjs",
    "visual:stitch": "npm run verify:runtime && node scripts/run-playwright.mjs test tests/visual/options.stitch-secondary.parity.spec.ts",
    "verify:stitch-secondary": "npm run preview:freeze-check && npx vitest run tests/unit/options/productionStitchShell*.test.ts tests/unit/options/stitchSharedRegistry.test.ts tests/unit/options/optionsIndexHtmlModalHosts.test.ts tests/unit/options/nativeLeafWidgets.test.ts tests/unit/optionsPreviewRuntime.test.ts && npm run visual:stitch && node scripts/run-playwright.mjs test tests/visual/preview.runtime.alignment.spec.ts tests/visual/preview.task-success.layout.spec.ts --project=chromium-desktop",
    "verify:preflight": "npm run verify:runtime && npm run typecheck:app && npm run typecheck:tests && npm run typecheck:strict && npm run release:metadata:check && npm run i18n:catalog:check && npm run audit:i18n-uncatalogued-user-copy:check && npm run audit:ga:proxy-contract && npm run audit:ga:docs && npm run audit:ga:legacy-api && npm run lint -- --quiet && npm run build:dev && npm run audit:ga:client-secret && npm run audit:ga:release-surface && npm run audit:imports:check && npm run audit:ui-architecture:report && npm run audit:interaction-contract:report && npm run audit:options-mainline:report && npm run audit:build:report && npm run audit:performance:report",
    "verify:preflight:full": "npm run verify:preflight && npm run test:e2e:browser && npm run test:e2e:browser:smoke",
    "test:ci": "npm run verify:runtime && npm run test:unit && npm run test:e2e && npm run test:e2e:browser && npm run test:e2e:browser:reader-panel && npm run test:e2e:browser:firefox",
    "visual:test": "npm run verify:runtime && node scripts/run-playwright.mjs test --config=playwright.config.ts",
    "visual:test:parallel": "npm run verify:runtime && npm run build:dev && node scripts/run-browser-test-shards.mjs visual",
    "visual:record": "npm run verify:runtime && node scripts/run-playwright.mjs test --config=playwright.config.ts --update-snapshots",
    "report:options-legacy": "node tools/options-css-legacy-report.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:ci": "node scripts/package.mjs",
    "package:chrome:isolated": "npm run build:chrome:isolated && node scripts/package.mjs --dist-dir build/dist-chrome",
    "package:firefox": "npm run build:firefox && node scripts/package-firefox.mjs",
    "package:firefox:isolated": "npm run build:firefox:isolated && node scripts/package-firefox.mjs --dist-dir build/dist-firefox",
    "package:firefox:sign": "npm run build:firefox && node scripts/package-firefox.mjs --sign",
    "package:trial": "node scripts/package-trial.mjs",
    "package:trial:quick": "node scripts/package-trial.mjs --skip-build",
    "release": "npm run build && node scripts/create-release.mjs",
    "release:chrome": "npm run release:chrome:dry-run --",
    "release:chrome:dry-run": "node scripts/publish-chrome-webstore.mjs --dry-run",
    "release:chrome:publish": "node scripts/publish-chrome-webstore.mjs --publish",
    "prepare": "husky",
    "test:coverage": "npm run verify:runtime && vitest run --config vitest.unit.config.ts --coverage",
    "audit:ui-architecture:report": "node tools/report-ui-architecture-alignment.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "focus-trap": "^7.6.6",
    "intl-messageformat": "^10.7.18",
    "lucide": "^0.554.0",
    "turndown": "^7.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.1.42",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/jsdom": "^21.1.5",
    "@types/node": "^22.19.19",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "4.1.9",
    "archiver": "^6.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "stylelint": "^16.26.1",
    "tsx": "^4.22.3",
    "typescript": "^5.5.4",
    "vitest": "4.1.9",
    "web-ext": "^10.4.0"
  },
  "overrides": {
    "ajv@<6.14.0": "6.15.0",
    "ajv@>=7.0.0-alpha.0 <8.18.0": "8.20.0",
    "brace-expansion@<1.1.13": "1.1.15",
    "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
    "eslint@^8.57.1": {
      ".": "$eslint",
      "ajv": "6.15.0"
    },
    "fast-uri@<=3.1.1": "3.1.2",
    "lodash@<=4.17.23": "4.18.1",
    "minimatch@9.0.9": {
      "brace-expansion": "2.0.3"
    },
    "minimatch@<=3.1.3": "3.1.5",
    "minimatch@>=5.0.0 <5.1.8": "5.1.9",
    "node-forge@<=1.3.3": "1.4.0",
    "picomatch@<=2.3.1": "2.3.2",
    "undici@>=7.0.0 <7.28.0": "7.28.0",
    "ws@>=8.0.0 <8.20.1": "8.21.0"
  },
  "lint-staged": {
    "{src,tests}/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/options/**/*.css": [
      "stylelint --fix",
      "npm run report:options-legacy"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
